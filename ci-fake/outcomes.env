# Which way each fake CI job goes. Set a value to `fail` to make that job fail.
#
# Editing this file is how the scratch test drives every outcome. One commit
# both flips an outcome and pushes a new commit, so it exercises the requeue
# path at the same time.
#
# A fork's pull request runs the fork's copy of this file, so flip it on the
# fork side when testing as a contributor.
LINT=pass
BUILD=pass
INFRA=pass
